# ==== Configurazione Telegram ====
# Token di un NUOVO bot creato con @BotFather. Non riusare quello di GdG-Event-Bot:
# due processi in polling con lo stesso token si bloccano a vicenda.
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# ID dell'utente o del gruppo admin: solo questa chat può usare il bot
ADMIN_CHAT_ID=123456789

# ==== Configurazione AI ====
# Provider che scrive gli articoli: gemini oppure claude
AI_PROVIDER=gemini
# Gemini (Google AI Studio)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.1-flash-lite
# Claude (Anthropic) - serve solo con AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ==== Assistente in chat (/scrivi) ====
# Provider e modello dell'assistente (opzionali: default AI_PROVIDER e il modello di quel provider).
# Consiglio: un modello più capace di gemini-3.1-flash-lite, che orchestra gli strumenti con meno affidabilità.
AGENT_PROVIDER=
AGENT_MODEL=
# Chiamate al modello per ogni messaggio dell'utente
AGENT_MAX_STEPS=12
# Oltre questi messaggi, o dopo queste ore di silenzio, la conversazione riparte da zero (si azzera a mano con /fine)
AGENT_MAX_MESSAGES=60
AGENT_IDLE_HOURS=12

# ==== Configurazione sito (repo GdG-Website) ====
ASTRO_GITHUB_REPO=GildaDelGrifone/GdG-Website
# Branch da cui il sito fa il deploy: la pubblicazione fa il merge qui
ASTRO_GITHUB_BRANCH=main
# Token fine-grained con Contents read/write solo su quel repo
ASTRO_GITHUB_TOKEN=github_pat_xxxx
ASTRO_BASE_URL=https://www.gildadelgrifonetorino.it
# Cartelle dei contenuti nel repo del sito
NEWS_CONTENT_DIR=src/content/news
COLLAB_CONTENT_DIR=src/content/collaborazioni

# ==== Configurazione Cloudflare R2 (immagini) ====
R2_ACCOUNT_ID=abc123
R2_ACCESS_KEY_ID=xxxx
R2_SECRET_ACCESS_KEY=xxxx
R2_BUCKET=gdg-media
# URL pubblico del bucket, senza slash finale
R2_PUBLIC_URL=https://media.gildadelgrifonetorino.it

# ==== Testi degli articoli ====
# Usati nei prompt (chiusura degli articoli): tutti opzionali
ASSOCIATION_ADDRESS=Gilda del Grifone, Via Ada Negri 8/A, Torino
OPENING_HOURS=lunedì, mercoledì e venerdì dalle 20:45 alle 24:00
TELEGRAM_GROUP_URL=https://t.me/+U5NEyDvN_fMxZTQ0
# Contatti Telegram per proporre iniziative, separati da virgola
ARTICLE_CONTACTS=@Destard,@ManueleAbi
# Nome del bot Telegram con cui si prenotano i tavoli (l'AI lo cita solo se serve)
BOOKING_BOT_NAME=Grifone Scriba

# ==== Varie ====
# Cartella per database e file temporanei
DATA_DIR=data
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
